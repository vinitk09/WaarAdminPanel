# Optional: preconfigure administrator access instead of the temporary default account.
# Set a unique password of at least 12 characters before using environment login.
WAARR_ADMIN_EMAIL=
WAARR_ADMIN_PASSWORD=
# Use a random 32-byte or longer secret for persistent deployment sessions.
WAARR_ADMIN_SESSION_SECRET=

# Optional absolute paths. Defaults work with the existing folder structure:
# WaarWebsite/Waar and WaarWebsite/WaarAdminPanel/waaradminpanel
WAARR_WEBSITE_PATH=
WAARR_ADMIN_DATA_PATH=
